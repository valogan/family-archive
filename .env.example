# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM (OpenAI-compatible; defaults to local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3

# Where uploaded media is stored
UPLOAD_DIR=
